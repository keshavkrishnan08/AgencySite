# PrepPath environment variables
# The app is fully functional WITHOUT any keys (it uses a built-in heuristic
# scoring engine). Add a key below to upgrade scoring/generation to Claude.

# Anthropic Claude API (optional — enables live AI scoring + question generation)
ANTHROPIC_API_KEY=

# Model to use (defaults to a current Sonnet if unset)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Stripe (optional — enables REAL payments) -------------------------------
# Without these, /upgrade runs a demo checkout (no charge). With them, it runs
# live Stripe Checkout. See MONETIZATION.md for the full go-live runbook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=            # monthly price id, e.g. price_123  ($9.99/mo)
STRIPE_PRICE_ID_ANNUAL=     # annual price id (optional)        ($79/yr)
STRIPE_WEBHOOK_SECRET=      # from `stripe listen` or the dashboard
STRIPE_TRIAL_DAYS=7         # free trial length (0 to disable)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Analytics (optional — funnel measurement) ------------------------------
# Without a key, analytics no-ops. With one, key funnel events flow to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Supabase (optional — real accounts + cross-device Premium) -------------
# Needed to enforce Premium for real customers (see "Go live" in MONETIZATION.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
