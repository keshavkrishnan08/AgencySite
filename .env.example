# Axon Careers environment variables
# The app is fully functional WITHOUT any keys (it uses a built-in heuristic
# scoring engine). Add a key below to upgrade scoring/generation to Claude.

# Anthropic Claude API (optional — enables live AI scoring + question generation)
ANTHROPIC_API_KEY=

# Model to use (defaults to a current Sonnet if unset)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Stripe (optional — enables REAL payments) -------------------------------
# Without these, /upgrade runs a demo checkout (no charge). With them, it runs
# live Stripe Checkout. See MONETIZATION.md for the full go-live runbook.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # pk_test_... or pk_live_... for client-side Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=            # monthly price id                   ($18.97 / month)
STRIPE_PRICE_ID_QUARTERLY=  # 3-month price id                   ($49.97 every 3 months)
STRIPE_PRICE_ID_ANNUAL=     # yearly price id                    ($119 / year)
STRIPE_WEBHOOK_SECRET=      # from `stripe listen` or the dashboard
STRIPE_TRIAL_DAYS=0         # free trial length (0 = charge immediately)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Analytics (optional — funnel measurement) ------------------------------
# Mixpanel is the analysis surface: funnels, retention, session replay, and
# autocaptured click-through rates. Without a token it no-ops entirely.
NEXT_PUBLIC_MIXPANEL_TOKEN=          # Mixpanel > Settings > Project Settings > Project Token
NEXT_PUBLIC_MIXPANEL_REPLAY_PCT=10   # % of sessions to record for replay (0 disables)

# Meta Pixel, so the ad campaign can optimise for and attribute conversions.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Supabase (optional — real accounts + cross-device Premium) -------------
# Needed to enforce Premium for real customers (see "Go live" in MONETIZATION.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # current Supabase dashboard name
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # legacy name; either public key name is fine
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (optional — welcome + plan emails via Resend) --------------------
# Without a key, email no-ops. Recurring reminders also need Vercel Cron.
RESEND_API_KEY=
EMAIL_FROM=Axon Careers <onboarding@resend.dev>
